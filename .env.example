; DATABASE
POSTGRES_PRISMA_URL=postgresql://postgres:1234@localhost
POSTGRES_URL_NON_POOLING=postgresql://postgres:1234@localhost

; FEATURES
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=
NEXT_PUBLIC_ENABLE_CATEGORY_EXTRACT= ; Requires AI PROVIDER and OBJECT STORAGE
NEXT_PUBLIC_ENABLE_EXPENSE_DOCUMENTS= ; Requires AI PROVIDER and OBJECT STORAGE

; OBJECT STORAGE
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=
S3_UPLOAD_ENDPOINT=
NEXT_PUBLIC_S3_MAX_FILE_SIZE=

; AI PROVIDER
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL= ; Required for NEXT_PUBLIC_ENABLE_EXPENSE_DOCUMENTS
OPENAI_TEXT_MODEL= ; Required for NEXT_PUBLIC_ENABLE_CATEGORY_EXTRACT

; LOGIN / GROUP SYNC (optional - anonymous, URL-based group access always
; works regardless of this section; signing in only unlocks syncing your
; own groups across devices). Auth is handed off entirely to one or more
; OIDC providers - no SMTP/email needed. Leave OIDC_PROVIDERS empty (the
; default) to keep the feature fully disabled.
AUTH_SECRET= ; openssl rand -base64 32 - required if OIDC_PROVIDERS is set
AUTH_URL= ; e.g. https://spliit.example.com - strongly recommended behind a
; reverse proxy: @auth/core's header-based origin auto-detection
; (x-forwarded-host/host) is unreliable in some proxy setups and silently
; falls back to http://localhost:3000 for callback/error redirects, which
; will not match what's registered with your OIDC provider.
OIDC_PROVIDERS= ; comma-separated provider ids, e.g. "zitadel,keycloak"
; For each id listed above, set:
;   OIDC_PROVIDER_<ID>_NAME=
;   OIDC_PROVIDER_<ID>_ISSUER=
;   OIDC_PROVIDER_<ID>_CLIENT_ID=
;   OIDC_PROVIDER_<ID>_CLIENT_SECRET=

; /admin (read-only instance stats), like Traefik's own /dashboard entrypoint -
; off by default, independent of the OIDC_PROVIDERS setting above. When on,
; access still requires signing in with a Zitadel/OIDC "admin" role grant.
ENABLE_ADMIN=false
