; DATABASE
; Both URLs must name the database explicitly (the /postgres below). Since
; Prisma 7 the pg driver adapter no longer defaults to the `postgres`
; database - it inherits pg's own default, which is the *username* - so a URL
; without a database path connects somewhere that has no schema and every
; query fails with "The table public.Group does not exist".
; See https://github.com/spliit-app/spliit/issues/618
POSTGRES_PRISMA_URL=postgresql://postgres:1234@localhost/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:1234@localhost/postgres

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR

# Opt-in features — uncomment to enable. See the README for what each needs.

# Attach images to expenses (requires S3 storage):
# ENABLE_EXPENSE_DOCUMENTS=true
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=
# S3_UPLOAD_ENDPOINT=       # only needed for non-AWS S3 providers

# Create expenses by scanning receipts (requires OpenAI and expense documents):
# ENABLE_RECEIPT_EXTRACT=true
# OPENAI_API_KEY=

# Auto-suggest the expense category from its title (requires OpenAI):
# ENABLE_CATEGORY_EXTRACT=true
# OPENAI_API_KEY=

# OpenAI options for the receipt and category features (see the README).
# OPENAI_BASE_URL=          # OpenAI-compatible endpoint; defaults to OpenAI
# OPENAI_MODEL_RECEIPT_EXTRACT=gpt-5-nano
# OPENAI_MODEL_CATEGORY_EXTRACT=gpt-5-nano

# Analytics is disabled unless a provider is selected. See the README.
# ANALYTICS_PROVIDER=console
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=your-domain.com

# Client-side size cap for expense-document uploads, in bytes. Uploads go
# through the app's own backend (private bucket, presigned URLs), so this only
# lets the browser reject an oversized file before asking for a URL.
# NEXT_PUBLIC_S3_MAX_FILE_SIZE=5242880

# --- Fork additions ------------------------------------------------------
# Login / group sync (optional). Anonymous, URL-based group access always
# works regardless of this section; signing in only unlocks syncing your own
# groups across devices. Auth is handed off entirely to one or more OIDC
# providers - no SMTP/email needed. Leave OIDC_PROVIDERS unset (the default)
# to keep the feature fully hidden: no nav entry, no sign-in UI, no sync.
# AUTH_SECRET=              # openssl rand -base64 32; required if OIDC_PROVIDERS is set
# AUTH_URL=https://spliit.example.com
#   Strongly recommended behind a reverse proxy: @auth/core's header-based
#   origin auto-detection (x-forwarded-host/host) is unreliable in some proxy
#   setups and silently falls back to http://localhost:3000 for callback and
#   error redirects, which will not match what's registered with the provider.
# OIDC_PROVIDERS=zitadel,keycloak    # comma-separated provider ids
#   For each id listed above, set:
#     OIDC_PROVIDER_<ID>_NAME=
#     OIDC_PROVIDER_<ID>_ISSUER=
#     OIDC_PROVIDER_<ID>_CLIENT_ID=
#     OIDC_PROVIDER_<ID>_CLIENT_SECRET=
#   Any of these may instead be supplied as <VAR>_FILE=/run/secrets/... and the
#   container entrypoint will read the value from that file.

# /admin (read-only instance stats plus the instance settings below), like
# Traefik's own /dashboard entrypoint - off by default, independent of
# OIDC_PROVIDERS. When on, access still requires signing in with an OIDC
# "admins" role grant.
# ENABLE_ADMIN=true
