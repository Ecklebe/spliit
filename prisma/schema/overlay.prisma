// Fork-only models, kept out of main.prisma so that upstream's edits to the
// shared schema merge without touching anything of ours. Prisma reads every
// *.prisma file in this folder as one schema (prisma.config.ts points at the
// folder rather than a single file), so relations across the two files work
// exactly as if they were still one document.
//
// The back-relation fields these models require - Group.syncedGroups,
// Participant.expenseComments / .activeSyncedGroupsForUser, Expense.comments /
// .location - necessarily stay in main.prisma, because Prisma needs both sides
// of a relation declared on the model that owns them. Those five lines are the
// only fork residue left in the shared file.

model Point {
  id        String   @id
  latitude  Float
  longitude Float
  Expense   Expense? @relation(fields: [id], references: [id], onDelete: Cascade)
}

model ExpenseComment {
  id            String      @id
  comment       String
  time          DateTime    @default(now())
  Expense       Expense?    @relation(fields: [expenseId], references: [id])
  expenseId     String?
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  syncProfile   SyncProfile?
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     SyncPreferences?
  syncedGroups    SyncedGroup[]
  omittedGroupIds String[]
  createdAt       DateTime         @default(now())
}

model SyncPreferences {
  id            String      @id @default(cuid())
  profileId     String      @unique
  profile       SyncProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  syncNewGroups Boolean     @default(false)
}

model SyncedGroup {
  id                  String       @id @default(cuid())
  profileId           String
  profile             SyncProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  groupId             String
  group               Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activeParticipantId String?
  activeParticipant   Participant? @relation(fields: [activeParticipantId], references: [id], onDelete: SetNull)
  isStarred           Boolean      @default(false)
  isArchived          Boolean      @default(false)
  syncedAt            DateTime     @default(now())

  @@unique([profileId, groupId])
}

// Admin-configurable instance settings, mutable at runtime from /admin (see
// src/lib/instance-settings.ts) - unlike env.ts, which is parsed once at
// process start and needs a redeploy to change. Singleton: exactly one row,
// seeded by this model's own migration (id = 'singleton'), never
// app-generated via randomId() like most other models.
model InstanceSettings {
  id                         String  @id
  requireLoginToCreateGroups Boolean @default(false)
}
